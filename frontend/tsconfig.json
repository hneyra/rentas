{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "verificaciones/**/*.ts",
    // `.tsx` tambien: `verificaciones/tipos/barreras-de-tipos.tsx` es una prueba DEL
    // COMPILADOR —`@ts-expect-error` falla cuando no hay error— y sin esta linea `tsc` ni
    // lo abriria, asi que las barreras de tipo dejarian de comprobarse en silencio.
    "verificaciones/**/*.tsx",
    // La siembra de desarrollo (#114). Fuera de `src/` a proposito —ver su cabecera— pero la
    // compila Vite igual que cualquier modulo, asi que tiene que pasar por `tsc`: un error de
    // tipos ahi solo aparecerian al abrir `yarn dev`, que es justo cuando nadie lo espera.
    "desarrollo/**/*.ts",
    // El arnes de extremo a extremo salio en #90 con las pantallas de V6 contra las que corria,
    // y volvio con la V8 sin volver aqui: Playwright transpila sin comprobar tipos, asi que un
    // fixture del arnes que se quedara corto frente a su operacion no lo decia nadie. Paso DOS
    // veces con la misma —`CorridaDelPredial`, en #271 y #313— y el rojo salio como un tiempo
    // agotado que no nombraba ni el archivo ni el campo. Desde #312 el arnes pasa por `tsc`.
    "e2e/**/*.ts",
    "eslint.prohibiciones.mjs",
    "vitest.setup.ts",
    "*.config.ts"
  ],
  // Las muestras violan las reglas A PROPOSITO y varias no compilan. Se lintan desde la
  // prueba, con su texto y una ruta sintetica; el compilador no tiene nada que hacer aqui.
  "exclude": ["verificaciones/muestras/**", "dist", "node_modules"],
  "compilerOptions": {
    "types": ["vite/client", "node", "@testing-library/jest-dom"]
  }
}
