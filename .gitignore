# Node: el descriptor de infraestructura
node_modules/
dist/
*.tsbuildinfo

# Gradle: el esquema y las verificaciones llegaron en P3; el negocio, en P5
.gradle/
build/
*/build/
backend/**/build/
backend/.gradle/

# IDE
.idea/
*.iml
.vscode/

# Sistema
.DS_Store

# Secretos: nunca, y `.gitleaks.toml` vigila que no se cuelen
*.local.*
.env

# El arnes de extremo a extremo (I-2). Nada de esto se versiona:
# `.estado/` son cookies de sesion de Keycloak —credenciales vivas— y los otros dos son
# salida de una corrida, que cambia en cada una y no dice nada de lo que el arnes verifica.
frontend/e2e/.estado/
frontend/playwright-report/
frontend/test-results/

# Los worktrees de agente y las skills instaladas NO son del producto.
#
# `.claude/worktrees/` ya se trago DOCE enlaces en este repositorio: un worktree es un
# directorio con su propio `.git`, asi que git lo anota como submodulo y el clon de otro
# no lo puede resolver — queda un `Subproject commit` que no existe en ninguna parte.
# `infrastructure` lo cubrio el 2026-09-12 citando ESTE incidente, y aqui —el unico de
# los seis donde ese directorio existe de verdad— se quedo sin cubrir.
#
# `.claude/skills/` es lo mismo por otro camino: dependencias de `npx skills add`, del
# puesto de quien trabaja y no del producto.
.claude/worktrees/
.claude/skills/
